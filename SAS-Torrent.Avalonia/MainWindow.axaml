<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SAS_Torrent.Avalonia"
        x:Class="SAS_Torrent.Avalonia.MainWindow"
        x:CompileBindings="True"
        Title="SAS Torrent"
        Width="500"
        Height="350"
        MinWidth="500"
        MinHeight="350">
  <Grid Margin="12">
    <Grid x:Name="SelectionView" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <StackPanel Grid.Row="0" Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <TextBlock Text="Торрент:" VerticalAlignment="Center" />
          <TextBox x:Name="TorrentPathBox"
                   Grid.Column="1"
                   Watermark="Перетащите .torrent сюда или выберите файл"
                   KeyDown="OnTorrentPathKeyDown"
                   LostFocus="OnTorrentPathLostFocus" />
          <Button Grid.Column="2"
                  Content="Обзор..."
                  Padding="10,4"
                  Click="OnBrowseTorrentClick" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <TextBlock Text="Папка:" VerticalAlignment="Center" />
          <TextBox x:Name="DownloadFolderBox"
                   Grid.Column="1"
                   KeyDown="OnDownloadFolderKeyDown"
                   LostFocus="OnDownloadFolderLostFocus" />
          <Button Grid.Column="2"
                  Content="Обзор..."
                  Padding="10,4"
                  Click="OnBrowseFolderClick" />
        </Grid>
      </StackPanel>

      <Border Grid.Row="1"
              Background="#12000000"
              CornerRadius="6"
              Padding="8,6">
        <StackPanel Spacing="2">
          <TextBlock x:Name="TorrentNameText"
                     Text="Торрент не выбран"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock x:Name="TorrentSizeText" Opacity="0.8" />
            <TextBlock x:Name="TorrentFilesText" Opacity="0.8" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2"
              BorderBrush="#33808080"
              BorderThickness="1"
              CornerRadius="6"
              ClipToBounds="True">
        <ListBox x:Name="FilesListBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="2">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="4,2" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:FileEntry">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RelativePath}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding SizeText}"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Row="3" Spacing="3">
        <Button x:Name="DownloadButton"
                Content="Download"
                Width="120"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                IsEnabled="False"
                Click="OnDownloadClick" />
        <TextBlock x:Name="SelectionProgressText"
                   Text="0 / 0"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Opacity="0.85" />
        <TextBlock x:Name="StatusText"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Foreground="#D9534F"
                   TextWrapping="Wrap"
                   MaxLines="2" />
      </StackPanel>
    </Grid>

    <Grid x:Name="DownloadView"
          IsVisible="False"
          RowDefinitions="*,Auto,Auto,Auto,Auto,*"
          RowSpacing="8">
      <TextBlock x:Name="DownloadTorrentNameText"
                 Grid.Row="1"
                 HorizontalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 MaxWidth="460" />
      <TextBlock x:Name="DownloadProgressText"
                 Grid.Row="2"
                 Text="0 / 0"
                 HorizontalAlignment="Center"
                 FontSize="26"
                 FontWeight="SemiBold" />
      <ProgressBar x:Name="DownloadProgressBar"
                   Grid.Row="3"
                   Height="16"
                   Margin="40,0"
                   Minimum="0"
                   Maximum="1"
                   Value="0" />
      <StackPanel Grid.Row="4" Spacing="4">
        <Button x:Name="StopButton"
                Content="Stop"
                Width="120"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                Click="OnStopClick" />
        <TextBlock x:Name="DownloadStatusText"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   MaxLines="2" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

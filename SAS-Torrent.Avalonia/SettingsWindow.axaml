<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SAS_Torrent.Avalonia.SettingsWindow"
        Title="Настройки"
        Width="560"
        Height="250"
        MinWidth="420"
        MinHeight="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
    <TextBlock Text="Постоянная папка для скачивания"
               FontWeight="SemiBold" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
      <TextBox x:Name="DownloadPathBox" IsReadOnly="True" />
      <Button x:Name="BrowseButton"
              Grid.Column="1"
              Content="Обзор..."
              Padding="10,4"
              Click="OnBrowseClick" />
    </Grid>

    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock x:Name="DefaultPathText"
                 Opacity="0.7"
                 TextWrapping="Wrap" />
      <TextBlock Text="Каждый торрент сохраняется в отдельную подпапку с его именем."
                 Opacity="0.7"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="ErrorText"
                 Foreground="#D9534F"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button x:Name="OpenFolderButton"
              Content="Открыть папку"
              Click="OnOpenFolderClick" />
      <Button x:Name="ResetButton"
              Content="Сбросить"
              Click="OnResetClick" />
      <Button x:Name="CancelButton"
              Content="Отмена"
              Click="OnCancelClick" />
      <Button x:Name="SaveButton"
              Content="Сохранить"
              Click="OnSaveClick"
              IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>

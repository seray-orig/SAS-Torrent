<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SAS_Torrent.Avalonia.SettingsWindow"
        Title="{DynamicResource Settings.Title}"
        Width="520"
        Height="230"
        MinWidth="420"
        MinHeight="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" Margin="18,14,18,12" Spacing="8">
      <TextBlock Classes="win10-instruction"
                 Text="{DynamicResource Settings.Header}" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox x:Name="DownloadPathBox" IsReadOnly="True" />
        <Button x:Name="BrowseButton"
                Grid.Column="1"
                Content="{DynamicResource Common.Browse}"
                Click="OnBrowseClick" />
      </Grid>

      <StackPanel Spacing="3">
        <TextBlock x:Name="DefaultPathText"
                   Foreground="#444444"
                   TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Settings.SubfolderHint}"
                   Foreground="#444444"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText"
                   Foreground="#A80000"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Classes="win10-footer">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button x:Name="OpenFolderButton"
                Content="{DynamicResource Settings.OpenFolder}"
                Click="OnOpenFolderClick" />
        <Button x:Name="ResetButton"
                Content="{DynamicResource Common.Reset}"
                Click="OnResetClick" />
        <Button x:Name="SaveButton"
                Classes="accent"
                Content="{DynamicResource Settings.Save}"
                Click="OnSaveClick"
                IsDefault="True" />
        <Button x:Name="CancelButton"
                Content="{DynamicResource Settings.Cancel}"
                Click="OnCancelClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>

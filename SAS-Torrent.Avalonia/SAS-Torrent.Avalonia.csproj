<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SAS_Torrent.Avalonia</RootNamespace>
    <AssemblyName>SAS-Torrent.Avalonia</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.xml;.nuspec</AllowedReferenceRelatedFileExtensions>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAS-Torrent.Core\SAS-Torrent.Core.csproj" />
  </ItemGroup>

  <Target Name="EmbedNativeLibraries"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="PrepareResourceNames">
    <ItemGroup>
      <EmbeddedResource Include="@(NativeCopyLocalItems)"
                        Condition="'%(NativeCopyLocalItems.Extension)' == '.dll'">
        <LogicalName>SAS_Torrent.Avalonia.Native.%(NativeCopyLocalItems.DestinationSubPath)</LogicalName>
      </EmbeddedResource>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveEmbeddedNativeLibrariesFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.AssetType)' == 'native' and '%(ResolvedFileToPublish.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

</Project>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SAS_Torrent.Avalonia.Theming.Win10TaskDialogStyles">

  <Style Selector="Window">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="FontFamily" Value="Segoe UI, Tahoma, sans-serif" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>

  <Style Selector="TextBlock.win10-instruction">
    <Setter Property="Foreground" Value="#003399" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBlock.win10-subtext">
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.win10-footer">
    <Setter Property="Background" Value="#F0F0F0" />
    <Setter Property="BorderBrush" Value="#DFDFDF" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="Border.win10-box">
    <Setter Property="Background" Value="#F9F9F9" />
    <Setter Property="BorderBrush" Value="#D9D9D9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#E1E1E1" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="BorderBrush" Value="#ADADAD" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,3" />
    <Setter Property="MinWidth" Value="75" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E5F1FB" />
    <Setter Property="BorderBrush" Value="#0078D7" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#CCE4F7" />
    <Setter Property="BorderBrush" Value="#005499" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#CCCCCC" />
    <Setter Property="BorderBrush" Value="#BFBFBF" />
    <Setter Property="Foreground" Value="#838383" />
  </Style>

  <Style Selector="Button.btn-blue">
    <Setter Property="Background" Value="#0078D7" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#005A9E" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.btn-blue:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#106EBE" />
    <Setter Property="BorderBrush" Value="#004578" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.btn-blue:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#005A9E" />
    <Setter Property="BorderBrush" Value="#003359" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.btn-green">
    <Setter Property="Background" Value="#10893E" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#0B6A2B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.btn-green:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0E7A36" />
    <Setter Property="BorderBrush" Value="#085221" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.btn-green:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#0B6A2B" />
    <Setter Property="BorderBrush" Value="#063B17" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.btn-red">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#961F22" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.btn-red:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A80000" />
    <Setter Property="BorderBrush" Value="#750000" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.btn-red:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#8A0000" />
    <Setter Property="BorderBrush" Value="#5A0000" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.close-btn">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#E1E1E1" />
    <Setter Property="BorderBrush" Value="#ADADAD" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#A80000" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.close-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FDE7E9" />
    <Setter Property="BorderBrush" Value="#D13438" />
    <Setter Property="Foreground" Value="#A80000" />
  </Style>

  <Style Selector="Button.close-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F1BBBC" />
    <Setter Property="BorderBrush" Value="#A80000" />
    <Setter Property="Foreground" Value="#750000" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="BorderBrush" Value="#7A7A7A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="23" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#171717" />
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#0078D7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="#E6E6E6" />
    <Setter Property="Foreground" Value="#06B025" />
    <Setter Property="BorderBrush" Value="#BCBCBC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Height" Value="14" />
    <Setter Property="MinHeight" Value="14" />
  </Style>

  <Style Selector="ProgressBar /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderBrush" Value="#707070" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="#0B6A2B" />
    <Setter Property="BorderBrush" Value="#085221" />
  </Style>

  <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="#10893E" />
    <Setter Property="BorderBrush" Value="#0B6A2B" />
  </Style>

  <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="#063B17" />
    <Setter Property="BorderBrush" Value="#063B17" />
  </Style>

  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="#FFFFFF" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#828790" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="Expander">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9D9D9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
</Styles>